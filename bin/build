#!/usr/bin/env bash
# Build one or all packages in pkgbuilds/, using a clean archlinux Docker
# container so builds are reproducible and never touch the host.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PKGBUILDS_DIR="$ROOT/pkgbuilds"
REPO_DIR="$ROOT/repo"
BUILD_IMAGE="archlinux:latest"

mkdir -p "$REPO_DIR"

# Extract the package name from a built artifact's filename
# (NAME-PKGVER-PKGREL-ARCH.pkg.tar.zst -> NAME), stripping the trailing
# three dash-separated fields positionally. Relies on PKGREL and ARCH never
# containing a dash (always true: PKGREL is a plain integer, ARCH is
# x86_64/any/...) and, for every PKGBUILD in this repo, PKGVER not
# containing one either -- NAME itself may (e.g. lib32-gamemode).
pkgfile_name() {
    echo "$1" | sed -E 's/-[^-]+-[^-]+\.pkg\.tar\.zst$//; s/-[^-]+$//'
}

build_one() {
    local pkg="$1"
    local pkgdir="$PKGBUILDS_DIR/$pkg"

    if [ ! -f "$pkgdir/PKGBUILD" ]; then
        echo "error: $pkgdir/PKGBUILD not found" >&2
        return 1
    fi

    echo "==> Building $pkg in a clean archlinux container"

    # Mount our own published repo (if `bin/publish` has run) as a local
    # pacman source, so meta-packages that depend on other omarchy-gaming
    # packages (e.g. omarchy-gaming-base) can resolve them with `makepkg -s`
    # without reaching outside our own infrastructure.
    docker run --rm \
        -v "$pkgdir":/build \
        -v "$REPO_DIR":/repo:ro \
        -w /build \
        "$BUILD_IMAGE" \
        bash -c '
            set -e
            grep -q "^\[multilib\]" /etc/pacman.conf || printf "\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n" >> /etc/pacman.conf
            if [ -f /repo/omarchy-gaming.db ]; then
                grep -q "^\[omarchy-gaming\]" /etc/pacman.conf || printf "\n[omarchy-gaming]\nSigLevel = Optional TrustAll\nServer = file:///repo\n" >> /etc/pacman.conf
            fi
            pacman -Syu --noconfirm --needed base-devel sudo git
            useradd -m builder
            echo "builder ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builder
            chown -R builder:builder /build
            su builder -c "makepkg -s --noconfirm --clean"
        '

    shopt -s nullglob
    local artifacts=("$pkgdir"/*.pkg.tar.zst)
    shopt -u nullglob

    if [ ${#artifacts[@]} -eq 0 ]; then
        echo "error: no package artifacts produced for $pkg" >&2
        return 1
    fi

    local new_names=()
    for artifact in "${artifacts[@]}"; do
        new_names+=("$(pkgfile_name "$(basename "$artifact")")")
    done

    mv -f "${artifacts[@]}" "$REPO_DIR/"
    rm -rf "$pkgdir/src" "$pkgdir/pkg"
    rm -f "$pkgdir"/*.log

    # Remove any previously-published version of the package(s) we just
    # built, so repo/ doesn't silently accumulate superseded artifacts
    # (Proton/Mesa builds run 100s of MB-1GB+ each) on every version bump.
    # repo-add only ever updates a pkgname's *database entry* to the newest
    # version -- it never deletes the old .pkg.tar.zst file, so this has to
    # happen here. Matched by exact package name (extracted the same way
    # makepkg names files: NAME-PKGVER-PKGREL-ARCH.pkg.tar.zst, right-to-left
    # so a dash-containing NAME like lib32-gamemode still works), not a
    # prefix glob -- a glob would also sweep up unrelated same-prefixed
    # packages, e.g. "mesa-*" matching "mesa-debug"/"mesa-docs".
    shopt -s nullglob
    local existing=("$REPO_DIR"/*.pkg.tar.zst)
    shopt -u nullglob
    local f fname is_new name
    for f in "${existing[@]}"; do
        fname="$(basename "$f")"
        is_new=false
        for artifact in "${artifacts[@]}"; do
            [ "$fname" = "$(basename "$artifact")" ] && is_new=true && break
        done
        $is_new && continue

        for name in "${new_names[@]}"; do
            if [ "$(pkgfile_name "$fname")" = "$name" ]; then
                echo "==> Removing stale $fname"
                rm -f "$f"
                break
            fi
        done
    done

    echo "==> Built $pkg -> $REPO_DIR"

    # Republish immediately so later packages in the same run (or a later
    # `bin/build` invocation) can resolve dependencies on whatever we just
    # built, e.g. omarchy-gaming-base depending on mesa/gamemode/mangohud.
    # bin/publish handles its own host-repo-add-vs-Docker fallback, so just
    # call it unconditionally rather than re-checking for repo-add here.
    "$ROOT/bin/publish" >/dev/null
}

# Packages that depend on other packages built in this same repo must come
# after everything else, and after each other in this order — a plain
# alphabetical build order can otherwise process a dependent (e.g.
# omarchy-gaming-amd) before its own dependency (omarchy-gaming-base) even
# exists yet.
META_PKG_ORDER=(omarchy-gaming-base omarchy-gaming-amd omarchy-gaming-nvidia)

if [ "$#" -eq 0 ]; then
    shopt -s nullglob
    pkgs=("$PKGBUILDS_DIR"/*/PKGBUILD)
    shopt -u nullglob

    if [ ${#pkgs[@]} -eq 0 ]; then
        echo "No PKGBUILDs found under $PKGBUILDS_DIR" >&2
        exit 1
    fi

    ordered=()
    for pkgbuild in "${pkgs[@]}"; do
        pkg="$(basename "$(dirname "$pkgbuild")")"
        is_meta=false
        for m in "${META_PKG_ORDER[@]}"; do
            [ "$pkg" = "$m" ] && is_meta=true && break
        done
        $is_meta || ordered+=("$pkg")
    done
    for m in "${META_PKG_ORDER[@]}"; do
        [ -d "$PKGBUILDS_DIR/$m" ] && ordered+=("$m")
    done

    failed=()
    for pkg in "${ordered[@]}"; do
        build_one "$pkg" || failed+=("$pkg")
    done

    if [ ${#failed[@]} -gt 0 ]; then
        echo "==> Build failed for: ${failed[*]}" >&2
        exit 1
    fi
else
    for pkg in "$@"; do
        build_one "$pkg"
    done
fi
