# Maintainer: omarchy-gaming
pkgname=omarchy-gaming-nvidia
pkgver=1
pkgrel=1
pkgdesc="NVIDIA-specific meta-package for omarchy-gaming: userspace driver stack + DRM KMS tuning"
arch=('any')
license=('MIT')
depends=('omarchy-gaming-base' 'nvidia-utils' 'lib32-nvidia-utils' 'nvidia-settings')
optdepends=('nvidia-open-dkms: open-source kernel modules, Turing (RTX 20xx) or newer'
            'nvidia-open: open-source kernel modules for the stock linux kernel, Turing or newer'
            'libxnvctrl: lets mangohud read NVIDIA GPU stats via XNVCtrl')
backup=('etc/modprobe.d/omarchy-gaming-nvidia.conf')
source=('nvidia-drm-modeset.conf')
sha256sums=('b1b2cace5bf2724b716a63ea058cf1ee29890f3ec7e29d5889226357b85b3fc4')

package() {
    install -Dm644 "$srcdir/nvidia-drm-modeset.conf" "$pkgdir/etc/modprobe.d/omarchy-gaming-nvidia.conf"
}
