# Maintainer: omarchy-gaming
pkgname=proton-cachyos
_srctag=11.0-20261005
pkgver=${_srctag//-/.}
pkgrel=1
pkgdesc="CachyOS's performance-tuned Proton (Steam Linux Runtime build, x86-64-v3), prebuilt binary repack"
arch=('x86_64')
url="https://github.com/CachyOS/proton-cachyos"
license=('custom')
options=('!strip' 'emptydirs')
install=proton-cachyos.install
source=("https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-${_srctag}-slr/proton-cachyos-${_srctag}-slr-x86_64_v3.tar.xz"
        "ntsync.conf")
sha512sums=('e8f492e75915486a2cdf29fbd1afd189f750153d053f32395e1171d7df65ac05361a43fa833948092d5e6c18938f658ed7879f92a81a9ad57a14c73034f7f45c'
            'SKIP')

package() {
    local _srcdir_name="proton-cachyos-${_srctag}-slr-x86_64_v3"
    local instdir="$pkgdir/usr/share/steam/compatibilitytools.d/${pkgname}"

    # Upstream's release tarball already ships a working compatibilitytool.vdf
    # / toolmanifest.vdf (install_path "."), so this is a straight copy.
    install -d "$instdir"
    cp -a "$srcdir/${_srcdir_name}/." "$instdir/"

    # CachyOS Proton's low-latency wine sync backend; harmless if the
    # running kernel predates ntsync support, module load just no-ops.
    install -Dm644 "$srcdir/ntsync.conf" "$pkgdir/usr/lib/modules-load.d/10-${pkgname}.conf"
}
