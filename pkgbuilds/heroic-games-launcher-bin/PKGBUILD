# Maintainer: omarchy-gaming
pkgname=heroic-games-launcher-bin
pkgver=2.22.4
pkgrel=1
pkgdesc="Open source launcher for Epic, Amazon and GOG games, prebuilt binary repack"
arch=('x86_64')
url="https://heroicgameslauncher.com/"
license=('GPL-3.0-only')
depends=('which' 'gtk3')
provides=('heroic-games-launcher')
conflicts=('heroic-games-launcher')
options=('!strip')
_filename="Heroic-$pkgver-linux-x64.pacman"
source=("https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v$pkgver/$_filename")
noextract=("$_filename")
sha256sums=('a5a798ee49bb4a20d3d163f46f39382389974cf4f818b49aa715e1b74d2a0eb0')

package() {
    tar -xJ -C "$pkgdir" -f "$srcdir/$_filename" usr opt
    install -d "$pkgdir/usr/bin"
    ln -s /opt/Heroic/heroic "$pkgdir/usr/bin/heroic"
}
